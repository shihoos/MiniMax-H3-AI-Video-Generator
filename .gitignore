# ============================================================
# PRODUCTION RUNTIME OUTPUTS
# ============================================================

# Interactive production sessions
data/production/sessions/*
!data/production/sessions/.gitkeep

# H3 shot outputs / temporary runtime files
data/production/*/h3/*
!data/production/*/h3/.gitkeep

# Final assembled videos
data/production/*/final/*
!data/production/*/final/.gitkeep

# Per-production continuity state
data/production/*/continuity/*
!data/production/*/continuity/.gitkeep

# Per-production identity anchors
data/production/*/identity/*
!data/production/*/identity/.gitkeep

# Generic legacy production runtime artifacts
data/production/continuity/*
!data/production/continuity/.gitkeep

data/production/identity/*
!data/production/identity/.gitkeep

# ============================================================
